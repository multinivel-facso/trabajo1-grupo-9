agg_datos %>% select(cuan_dem, prom_imp_dem) %>%
sjmisc::descr(show = c("label", "range", "mean", "sd", "NA.prc", "n")) %>%
kable(., digits = 2, "markdown", caption = "Variables nivel 2")
