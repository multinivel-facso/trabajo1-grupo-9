options(scipen = 999)
rm(list = ls())
load(file="procesamiento/data/data.RData")
datos_limpios <- datos %>%
haven::zap_labels() %>%  # Elimina atributos de etiquetas
ungroup()
datos_limpios %>% select(indice_dem, país, grp_econ, imp_dem, mujer) %>%
ungroup() %>%
sjmisc::descr(show = c("label","range", "mean", "sd", "NA.prc", "n"))%>%
